    { "id": "arabic-caesar", "action": "encrypt", "cipher": "caesar", "alphabet": "arabic", "params": { "shift": 5 }, "text": "مرحبا بالعالم" },
    { "id": "enigma", "action": "encrypt", "cipher": "enigma", "params": { "rotors": "I II III", "reflector": "B", "plugboard": "AB CD" }, "text": "HELLOWORLD" },
